# J&B's RPG Configuration

# =============================================================================
# Development: Run both servers, access everything through FRONTEND_PORT
#   just backend      → API server on BACKEND_PORT (8000)
#   just frontend-dev → Vite on FRONTEND_PORT (5173) - use this URL for everything
#
# Production/Docker: Single server on BACKEND_PORT serves both API and frontend
# =============================================================================

# Backend API server port
BACKEND_PORT=8000

# Frontend dev server port (Vite - only used during development)
FRONTEND_PORT=5173

# Data directory (local: ./data, Docker: /data)
DATA_DIR=./data

# Admin authentication (protects editor and storyteller views)
# Leave empty to disable auth (useful for local development)
ADMIN_USER=
ADMIN_PASSWORD=

# Set to "true" to bypass admin authentication entirely
AUTH_DISABLED=true

# Base URL for shareable player links (e.g., https://yourdomain.com)
# Used when running behind a reverse proxy with a custom domain
# Leave empty to use the browser's current origin
BASE_URL=
