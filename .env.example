# J&B's RPG Configuration

# =============================================================================
# Development: Run both servers, access everything through FRONTEND_PORT
#   just backend      → API server on BACKEND_PORT (8000)
#   just frontend-dev → Vite on FRONTEND_PORT (5173) - use this URL for everything
#
# Production/Docker: Single server on BACKEND_PORT serves both API and frontend
# =============================================================================

# Backend API server port
BACKEND_PORT=8000

# Frontend dev server port (Vite - only used during development)
FRONTEND_PORT=5173

# Data directory (local: ./data, Docker: /data)
DATA_DIR=./data

# Admin authentication (protects the library, editor and storyteller views)
# Leave empty to have a login generated on first run (printed in the server log,
# saved in DATA_DIR/admin.json), or set your own
ADMIN_USER=
ADMIN_PASSWORD=

# Set to "true" to bypass admin authentication (local development only)
# For internet deployment, set to "false" and configure credentials above
AUTH_DISABLED=false

# CORS allowed origins (comma-separated)
# For production, set to your domain (e.g., https://yourdomain.com)
# Default allows localhost for development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8008

# Base URL for shareable player links (e.g., https://yourdomain.com)
# Used when running behind a reverse proxy with a custom domain
# Leave empty to use the browser's current origin
BASE_URL=

# Emblem service for heroes' crests (https://github.com/brentonmallen1/emblazon)
# Leave empty to draw the built-in crests only; they are also the fallback when it's down
EMBLAZON_URL=https://emblazon.mallen.us

# Docker registry for releases (e.g., registry.example.com)
REGISTRY_URL=
